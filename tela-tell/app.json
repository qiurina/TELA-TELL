{
  "expo": {
    "name": "TELA-TELL",
    "slug": "tela-tell",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/LOGO.png",
    "scheme": "telatell",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3A7792",
        "foregroundImage": "./assets/images/LOGO (1).png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.telatell.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/LOGO.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3A7792",
          "image": "./assets/images/LOGO (1).png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#3A7792"
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TELA-TELL to access your photos to upload fabric images for analysis.",
          "cameraPermission": "Allow TELA-TELL to use your camera to capture fabric photos for analysis."
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "react-native-fast-tflite",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4b32c8e-2a4b-4f57-b9d4-76c2f96b4e64"
      }
    }
  }
}
