{
  "expo": {
    "name": "tela-tell",
    "slug": "tela-tell",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/appiconv2.png",
    "scheme": "telatell",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E0F4F8",
        "foregroundImage": "./assets/images/appiconv2.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/appiconv2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E0F4F8",
          "image": "./assets/images/appiconv2.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#E0F4F8"
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TELA-TELL to access your photos to upload fabric images for analysis.",
          "cameraPermission": "Allow TELA-TELL to use your camera to capture fabric photos for analysis."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TELA-TELL to access your camera to scan fabric."
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
